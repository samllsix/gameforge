# GameForge Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM API Keys
# ===========================================
# Mimo大模型配置（策划、规划、场景生成等Agent使用）
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# DeepSeek配置（代码生成、测试生成、重构Agent使用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱GLM配置（Debugger Agent使用）
ZHIPU_API_KEY=your_zhipu_api_key_here

# Kimi配置（CodeReviewer Agent使用）
KIMI_API_KEY=your_kimi_api_key_here

# 备用模型配置（可选）
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# Vector Database Configuration
# ===========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgresql://gameforge:gameforge123@localhost:5433/gameforge
# For SQLite (fallback):
# DATABASE_URL=sqlite:///./gameforge.db

# ===========================================
# Application Settings
# ===========================================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your_secret_key_here

# ===========================================
# GameForge Environment & Security
# ===========================================
# 设为 production 时：禁用文档端点、收紧 CORS、强制 API Key 认证
GAMEFORGE_ENV=development
GAMEFORGE_HOST=0.0.0.0
GAMEFORGE_PORT=8000
# Docker Compose 宿主机端口。宿主机 8001 被占用时只改这个值；
# 容器内部端口和健康检查仍使用 GAMEFORGE_PORT。
GAMEFORGE_HOST_PORT=8001
# API 密钥（格式: key1:name1,key2:name2），生产环境必须设置
GAMEFORGE_API_KEYS=
# 生产环境 CORS 允许的源（逗号分隔）
GAMEFORGE_CORS_ORIGINS=

# ===========================================
# Unity/Unreal Integration
# ===========================================
UNITY_EDITOR_PATH=D:/Unity/2022.3.62f3c1/Editor/Unity.exe
UNITY_PROJECT_PATH=D:/Unity/GameForge
UNREAL_EDITOR_PATH=/path/to/UnrealEditor

# ===========================================
# Monitoring & Logging
# ===========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=gameforge
LOG_LEVEL=INFO

# ===========================================
# Agent Configuration - 使用Mimo大模型
# ===========================================
DEFAULT_MODEL=mimo-v2.5-pro
CODE_GENERATION_MODEL=mimo-v2.5-pro
TASK_PLANNING_MODEL=mimo-v2.5-pro
MAX_TOKENS=8192
TEMPERATURE=0.7

# ===========================================
# Sandbox Configuration
# ===========================================
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512MB
