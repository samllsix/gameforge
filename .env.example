# GameForge Environment Configuration
# Copy this file to .env and fill in your values
#
# 键名约定（与 config/config.yaml 保持一致）：
# - 密钥类（*_API_KEY）由 config.yaml 各段的 `api_key_env` 字段引用；
# - 运行参数（host/port/debug/模型选择等）以 config.yaml 为默认值，
#   环境变量仅用于覆盖；
# - 应用级配置键统一使用 GAMEFORGE_* 前缀（旧的 APP_* 前缀键已移除）；
# - 模型名/token/温度等已收敛到 config.yaml 的 llm / audio 段，不再在此重复。

# ===========================================
# LLM API Keys
# ===========================================
# Mimo大模型配置（策划、规划、场景生成等Agent使用）
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# DeepSeek配置（代码生成、测试生成、重构Agent使用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱GLM配置（Debugger Agent使用）
ZHIPU_API_KEY=your_zhipu_api_key_here

# Kimi配置（CodeReviewer Agent使用）
KIMI_API_KEY=your_kimi_api_key_here

# StepFun 世界模型（game_designer / step-3.7-flash，与图像/TTS 密钥分开管理）
STEPFUN_API_KEY=your_stepfun_api_key_here

# 备用模型配置（可选）
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# Image Generation API Keys
# ===========================================
# Step Image Edit 2 API（推荐：高质量图像生成）
STEP_API_KEY=your_step_api_key_here
STEP_BASE_URL=https://api.stepfun.com/step_plan/v1

# SenseNova U1.5 Lite API（备选：快速图像生成）
SENSENOVA_API_KEY=your_sensenova_api_key_here
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 图像生成偏好设置
IMAGE_PREFER_PROVIDER=step
IMAGE_OUTPUT_DIR=D:\comfyui\output

# ===========================================
# Audio / TTS 配置（AudioGeneratorAgent）
# ===========================================
# StepFun TTS（stepaudio-2.5-tts，对话/旁白生成）。
# 密钥与图像/世界模型分开管理；TTS 其余参数（base_url / model / voice /
# response_format）在 config.yaml 的 audio.providers.stepfun 段配置。
STEPFUN_TTS_API_KEY=your_stepfun_tts_api_key_here

# ===========================================
# Vector Database Configuration
# ===========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ===========================================
# Database Configuration
# ===========================================
# 方式 A（推荐：分项注入）
#   把数据库连接参数拆成 env，避免完整 URL 在 .env 里泄露密码。
#   密码优先级：GAMEFORGE_DB_PASSWORD > DBMY_PASSWORD（生产推荐前者）
#
DBMY_HOST=127.0.0.1
DBMY_PORT=3306
DBMY_USER=root
DBMY_DB=gameforge
DBMY_PASSWORD=123456
# GAMEFORGE_DB_HOST=10.0.0.5         # 生产：覆盖 DBMY_HOST
# GAMEFORGE_DB_PORT=3306
# GAMEFORGE_DB_USER=gameforge_app
# GAMEFORGE_DB_NAME=gameforge_prod
# GAMEFORGE_DB_PASSWORD=replace-with-vault-secret   # 生产密钥，运维注入

# 方式 B（兼容旧配置：直接传完整 URL）
# 当以下任一存在时，DBMY_* / GAMEFORGE_DB_* 被忽略：
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/gameforge?charset=utf8mb4
# DATABASE_URL=mysql://root:123456@127.0.0.1:3306/gameforge?charset=utf8mb4   # 自动注册 PyMySQL
# DATABASE_URL=postgresql://user:pwd@host:5432/db    # PostgreSQL（生产）
# DATABASE_URL=sqlite:///./data/gameforge.db         # SQLite（离线降级）

# ===========================================
# GameForge Environment & Security
# ===========================================
# 与 config.yaml 对应：app.environment→GAMEFORGE_ENV、app.debug→GAMEFORGE_DEBUG、
# server.host/port→GAMEFORGE_HOST/GAMEFORGE_PORT。
# 设为 production 时：禁用文档端点、收紧 CORS、强制 API Key 认证
GAMEFORGE_ENV=development
GAMEFORGE_DEBUG=true
GAMEFORGE_HOST=127.0.0.1
GAMEFORGE_PORT=8000
# Docker Compose 宿主机端口。宿主机 8001 被占用时只改这个值；
# 容器内部端口和健康检查仍使用 GAMEFORGE_PORT。
GAMEFORGE_HOST_PORT=8001
# API 密钥（格式: key1:name1,key2:name2），生产环境必须设置
GAMEFORGE_API_KEYS=
# Development-only escape hatch; accepted only for a loopback listener.
GAMEFORGE_ALLOW_INSECURE_LOCALHOST=false
# Shared token for the Godot editor's local HTTP control service.
GAMEFORGE_GODOT_HTTP_TOKEN=
# 生产环境 CORS 允许的源（逗号分隔）
GAMEFORGE_CORS_ORIGINS=
# MCP 服务的工作目录（config.yaml mcp.servers.*.cwd 的 ${GAMEFORGE_PROJECT_ROOT:.}）
# GAMEFORGE_PROJECT_ROOT=.
# 会话/签名密钥（独立密钥，无 config.yaml 对应键）
SECRET_KEY=your_secret_key_here

# ===========================================
# Godot Integration
# ===========================================
GODOT_EDITOR_PATH=/path/to/godot
GODOT_PROJECT_PATH=/path/to/project

# ===========================================
# Monitoring & Logging
# ===========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=gameforge
LOG_LEVEL=INFO

# ===========================================
# Sandbox Configuration（默认值见 config.yaml sandbox 段）
# ===========================================
# 任务工作区/快照根目录（默认 <repo>/workspace，已被 .gitignore 排除）
GAMEFORGE_WORKSPACE_ROOT=
# 生成的项目根目录（默认 <repo>/projects）
GAMEFORGE_PROJECTS_ROOT=
# 沙箱后端：local | docker（docker-compose 亦引用此键）
GAMEFORGE_SANDBOX_BACKEND=local